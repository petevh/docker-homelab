# n8n encryption key — protects stored credentials
# Generate with: openssl rand -base64 32
N8N_ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here

# Bank config (v2.0 schema, owned by the bank-automation repo). Single file, never committed.
# Default is the sibling checkout; override only if it lives elsewhere.
# BANK_CONFIG_FILE=../../bank-automation/private-config.json
# PDF passwords keyed by account key, kept apart so the main config holds no secrets.
# BANK_PASSWORDS_FILE=../../bank-automation/statement-passwords.json
